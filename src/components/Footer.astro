---
import { SITE, url } from '../lib/site.ts';
import Icon from './Icon.astro';

const source = SITE.defaultSource;
---

<footer class="site-footer">
  {/* Spaces around the links are written out: line breaks next to tags are not kept as spaces. */}
  <p>
    The wallpapers belong to their original artists and were collected from{' '}
    <a class="link" href={source.url}>{source.name}</a>. Want one credited or removed?{' '}
    <a class="link" href={`${SITE.repo}/issues/new/choose`}>Open an issue</a>. The code of this site is{' '}
    <a class="link" href={`${SITE.repo}/blob/main/LICENSE`}>MIT licensed</a>.
  </p>
  <ul>
    <li><a class="link" href={url('/tags/')}>All tags</a></li>
    <li><a class="link" href={`${SITE.repo}/blob/main/CONTRIBUTING.md`}>Contribute</a></li>
    <li><a class="link" href={url('/api/wallpapers.json')}>JSON</a></li>
    <li><a class="link" href={SITE.repo}>GitHub</a></li>
  </ul>
  {/* Filled in by scripts/visits.ts; stays hidden if the counter cannot be reached. */}
  <p class="site-footer__visits" data-visits hidden>
    Recorded page visits <span class="site-footer__count" data-visits-count></span>{' '}
    <span class="info" data-info>
      <button type="button" class="info__button" aria-label="About the counter" aria-describedby="visits-note">
        <Icon name="info" size={14} />
      </button>
      <span class="info__tip" id="visits-note" role="tooltip">
        The counter uses no cookies and stores only the total.
      </span>
    </span>
  </p>
</footer>
