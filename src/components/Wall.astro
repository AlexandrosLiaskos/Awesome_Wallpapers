---
import type { Indexed } from '../lib/filter.ts';
import type { Wallpaper } from '../lib/types.ts';
import { PAGE_SIZE, scopeKey, type WallScope } from '../lib/wall-batches.ts';
import Card from './Card.astro';

interface Props {
  /** Every wallpaper of the listing; the wall renders one page of them. */
  wallpapers: Wallpaper[];
  /** Adds the data the filters, search and sort need. One filterable wall per page. */
  filterable?: boolean;
  /** How many cards at the top load their image at once. */
  eager?: number;
  /** What the listing shows; on its first page the browser adds the rest of the scope. */
  scope?: WallScope;
  /** Which page of the listing this is, from 1. */
  page?: number;
}

const { wallpapers, filterable = false, eager = 0, scope, page = 1 } = Astro.props;
const shown = wallpapers.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
// Only a first page filters in place; later pages send their filters back to page 1.
const inPlace = filterable && page === 1;

// Before the compact index arrives, or if it never does, the browser filters the
// cards on the page with this. A listing that fits on one page needs nothing else,
// and the browser does not load the index for it.
const index: Indexed[] = inPlace
  ? shown.map((w) => ({
      slug: w.slug,
      title: w.title,
      tags: w.tags,
      size: w.size,
      shape: w.shape,
      colors: w.colors,
      pixels: w.width * w.height,
    }))
  : [];
// "<" is escaped so that no title can close the script element early.
const indexJson = JSON.stringify(index).replace(/</g, '\\u003c');
---

<div class="wall-wrap">
  <ul
    class="wall"
    data-wall
    data-filterable={filterable ? '' : undefined}
    data-scope={scope ? scopeKey(scope) : undefined}
    data-page={filterable ? page : undefined}
    data-total={filterable ? wallpapers.length : undefined}
  >
    {shown.map((wallpaper, i) => <Card wallpaper={wallpaper} eager={i < eager} />)}
  </ul>
</div>

{
  inPlace && (
    <>
      <div data-wall-more aria-hidden="true" />
      <div class="wall-empty" data-empty hidden>
        <p class="wall-empty__title">Nothing matches that.</p>
        <p class="wall-empty__text">Try fewer filters, or a tag such as nord, pixel art or landscape.</p>
        <button class="btn" type="button" data-clear>
          Clear all filters
        </button>
      </div>
      <script type="application/json" data-wall-index set:html={indexJson} />
    </>
  )
}
