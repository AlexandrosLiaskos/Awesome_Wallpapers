---
import { cardHtml, toCardData } from '../lib/card.ts';
import { tagLabels } from '../lib/data.ts';
import { url } from '../lib/site.ts';
import type { Wallpaper } from '../lib/types.ts';

interface Props {
  wallpaper: Wallpaper;
  /** Load at once instead of lazily; for the first few cards on a page. */
  eager?: boolean;
}

const { wallpaper, eager = false } = Astro.props;
// The browser builds the other cards with the same function.
const html = cardHtml(toCardData(wallpaper), { eager, base: url('/'), labels: tagLabels });
---

<Fragment set:html={html} />
