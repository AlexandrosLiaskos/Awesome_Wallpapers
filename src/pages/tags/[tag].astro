---
import FilterBar from '../../components/FilterBar.astro';
import Wall from '../../components/Wall.astro';
import Base from '../../layouts/Base.astro';
import { usedTags, wallpapers } from '../../lib/data.ts';
import { media } from '../../lib/site.ts';
import { byTag, type CountedTag } from '../../lib/site-data.ts';

export function getStaticPaths() {
  return usedTags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

interface Props {
  tag: CountedTag;
}

const { tag } = Astro.props;
const tagged = byTag(wallpapers, tag.slug);
const cover = tagged[0];
---

<Base
  title={`${tag.label} wallpapers`}
  description={`${tag.count} ${tag.label} wallpapers, free to download. ${tag.description}`}
  image={media('og', cover.slug)}
>
  <section class="intro">
    <div>
      <p class="caption intro__kicker">{tag.kind === 'palette' ? 'Palette' : 'Tag'}</p>
      <h1 class="intro__title">{tag.label} <em>wallpapers.</em></h1>
      <p class="intro__text">{tag.description}</p>
    </div>
    <dl class="stats">
      <div><dt class="caption">wallpapers</dt><dd>{tag.count}</dd></div>
      <div><dt class="caption">in 4K+</dt><dd>{tagged.filter((w) => w.size === '4k').length}</dd></div>
    </dl>
  </section>

  <FilterBar current={tag.slug} />
  <Wall wallpapers={tagged} filterable eager={8} />
</Base>
