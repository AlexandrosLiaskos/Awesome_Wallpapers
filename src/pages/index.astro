---
import FilterBar from '../components/FilterBar.astro';
import Pager from '../components/Pager.astro';
import Wall from '../components/Wall.astro';
import Base from '../layouts/Base.astro';
import { otherCollectionsText as others, tags, wallpapers } from '../lib/data.ts';
import { SITE, url } from '../lib/site.ts';
import { stats } from '../lib/site-data.ts';
import { pageCount } from '../lib/wall-batches.ts';

const totals = stats(wallpapers, tags);
const last = pageCount(wallpapers.length);
const next = last > 1 ? url('/page/2/') : undefined;

// Names the site in structured data. Google reads a site name only at the root of a
// domain or subdomain, so for Google this takes effect if the gallery gets its own domain.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  description: SITE.description,
};
---

<Base description={SITE.description}>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(website)} />
  {next && <link rel="next" href={next} slot="head" />}
  <section class="intro">
    <div>
      <h1 class="intro__title">Wallpapers worth <em>staring&nbsp;at.</em></h1>
      <p class="intro__text">
        A fast, searchable gallery of {totals.total} aesthetic wallpapers. Free to download, no ads, no tracking. The
        collection comes from <a class="link" href={SITE.defaultSource.url}>{SITE.defaultSource.name}</a>
        {others && <>{' '}and <a class="link" href={url('/sources/')}>{others}</a> on GitHub</>}.
      </p>
    </div>
    <dl class="stats">
      <div><dt class="caption">wallpapers</dt><dd>{totals.total}</dd></div>
      <div><dt class="caption">in 4K+</dt><dd>{totals.fourK}</dd></div>
      <div><dt class="caption">tags</dt><dd>{totals.tags}</dd></div>
    </dl>
  </section>

  <FilterBar />
  <Wall wallpapers={wallpapers} filterable eager={8} scope={{ kind: 'all' }} />
  <Pager current={1} last={last} next={next} scroll />
</Base>
